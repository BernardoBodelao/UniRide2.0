# Copie este arquivo para ".env" (na pasta backend) e ajuste os valores.
# Variáveis já definidas no sistema têm prioridade sobre as deste arquivo.

# Chave que assina o cookie de sessão. Em qualquer uso fora do seu computador, troque por uma chave própria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key

# Endereços do frontend autorizados a chamar a API, separados por vírgula.
CORS_ORIGINS=http://localhost:5173

# "false" em desenvolvimento local (HTTP). Use "true" quando servir por HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Opcional: caminho do arquivo SQLite (apesar do nome, não é uma URL).
# Sem esta variável, o banco fica em backend/uniride.db.
# DATABASE_URL=/caminho/absoluto/para/uniride.db
